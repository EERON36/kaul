generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMINISTRATOR
  STAFF_MEMBER
}

enum ClientStatus {
  INACTIVE
  ACTIVE
  ARCHIVED
}

enum AssignmentResponsibility {
  PRIMARY
  SECONDARY
}

enum AuditActorKind {
  USER
  SYSTEM
  UNAUTHENTICATED
}

enum AuditEventType {
  OUTCOME
  RECOVERY
}

enum AuditResult {
  SUCCEEDED
  FAILED
  AMBIGUOUS
}

enum JournalEntryStatus {
  DRAFT
  SIGNED
}

enum JournalContentFormat {
  LEGACY_NARRATIVE
  STRUCTURED_V1
}

enum JournalEntryType {
  DAILY_NOTE
  CONVERSATION
  PHONE_CALL
  MEETING
  HOME_VISIT
  SCHOOL_CONTACT
  OBSERVATION
  OTHER
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum FollowUpStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum MonthlyReportStatus {
  DRAFT
  SIGNED
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentScanResult {
  CLEAN
}

model Organisation {
  id               String            @id
  name             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  clients          Client[]          @relation("OrganisationClients")
  assignments      Assignment[]      @relation("OrganisationAssignments")
  journalEntries   JournalEntry[]    @relation("OrganisationJournalEntries")
  goals            Goal[]            @relation("OrganisationGoals")
  followUps        FollowUp[]        @relation("OrganisationFollowUps")
  monthlyReports   MonthlyReport[]   @relation("OrganisationMonthlyReports")
  documents        Document[]        @relation("OrganisationDocuments")
  documentVersions DocumentVersion[] @relation("OrganisationDocumentVersions")

  @@map("organisation")
}

model User {
  id                           String                          @id
  name                         String
  email                        String
  emailVerified                Boolean                         @default(false)
  image                        String?
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt
  role                         UserRole                        @default(STAFF_MEMBER)
  banned                       Boolean?                        @default(false)
  banReason                    String?
  banExpires                   DateTime?
  organisationId               String
  organisation                 Organisation                    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  professionalTitle            String
  mustChangePassword           Boolean                         @default(true)
  temporaryCredentialExpiresAt DateTime?
  sessions                     Session[]
  accounts                     Account[]
  staffAssignments             Assignment[]                    @relation("StaffAssignments")
  createdAssignments           Assignment[]                    @relation("AssignmentCreators")
  authoredJournalEntries       JournalEntry[]                  @relation("JournalEntryAuthors")
  createdGoals                 Goal[]                          @relation("GoalCreators")
  completedGoals               Goal[]                          @relation("GoalCompletionActors")
  archivedGoals                Goal[]                          @relation("GoalArchiveActors")
  createdFollowUps             FollowUp[]                      @relation("FollowUpCreators")
  responsibleFollowUps         FollowUp[]                      @relation("FollowUpResponsibleUsers")
  completedFollowUps           FollowUp[]                      @relation("FollowUpCompletionActors")
  cancelledFollowUps           FollowUp[]                      @relation("FollowUpCancellationActors")
  previousResponsibilities     FollowUpResponsibilityHistory[] @relation("PreviousResponsibleUsers")
  newResponsibilities          FollowUpResponsibilityHistory[] @relation("NewResponsibleUsers")
  actedResponsibilityChanges   FollowUpResponsibilityHistory[] @relation("ResponsibilityChangeActors")
  createdMonthlyReports        MonthlyReport[]                 @relation("MonthlyReportCreators")
  updatedMonthlyReports        MonthlyReport[]                 @relation("MonthlyReportUpdaters")
  createdDocuments             Document[]                      @relation("DocumentCreators")
  archivedDocuments            Document[]                      @relation("DocumentArchiveActors")
  uploadedDocumentVersions     DocumentVersion[]               @relation("DocumentVersionUploaders")

  @@unique([email])
  @@unique([organisationId, id])
  @@index([organisationId])
  @@map("user")
}

model Client {
  id                                    String                        @id @db.Uuid
  organisationId                        String
  organisation                          Organisation                  @relation("OrganisationClients", fields: [organisationId], references: [id], onDelete: Restrict)
  firstName                             String
  lastName                              String
  personIdentifier                      String
  personalIdentityNumberLegacyPlaintext String?
  placingUnit                           String?
  legalBasis                            String?
  responsibleSocialWorkerName           String?
  responsibleSocialWorkerPhone          String?
  responsibleSocialWorkerEmail          String?
  category                              String
  status                                ClientStatus                  @default(INACTIVE)
  archivedAt                            DateTime?
  createdAt                             DateTime                      @default(now())
  updatedAt                             DateTime                      @updatedAt
  assignments                           Assignment[]                  @relation("ClientAssignments")
  journalEntries                        JournalEntry[]                @relation("ClientJournalEntries")
  goals                                 Goal[]                        @relation("ClientGoals")
  followUps                             FollowUp[]                    @relation("ClientFollowUps")
  monthlyReports                        MonthlyReport[]               @relation("ClientMonthlyReports")
  personalIdentityNumber                ClientPersonalIdentityNumber?
  documents                             Document[]                    @relation("ClientDocuments")
  documentVersions                      DocumentVersion[]             @relation("ClientDocumentVersions")

  @@unique([organisationId, personIdentifier])
  @@unique([organisationId, id])
  @@index([organisationId, status, lastName, firstName, personIdentifier])
  @@map("client")
}

model ClientPersonalIdentityNumber {
  organisationId    String
  clientId          String @db.Uuid
  encryptionVersion Int    @db.SmallInt
  keyId             String @db.VarChar(64)
  nonce             Bytes
  ciphertext        Bytes
  authenticationTag Bytes
  client            Client @relation(fields: [organisationId, clientId], references: [organisationId, id], onDelete: Restrict, map: "clientPersonalIdentityNumber_scope_client_fkey")

  @@id([organisationId, clientId], map: "clientPersonalIdentityNumber_pkey")
  @@map("clientPersonalIdentityNumber")
}

model Assignment {
  id              String                   @id @db.Uuid
  organisationId  String
  organisation    Organisation             @relation("OrganisationAssignments", fields: [organisationId], references: [id], onDelete: Restrict)
  clientId        String                   @db.Uuid
  client          Client                   @relation("ClientAssignments", fields: [organisationId, clientId], references: [organisationId, id], onDelete: Restrict)
  staffUserId     String
  staffUser       User                     @relation("StaffAssignments", fields: [organisationId, staffUserId], references: [organisationId, id], onDelete: Restrict)
  responsibility  AssignmentResponsibility
  startedAt       DateTime                 @default(now())
  endedAt         DateTime?
  createdAt       DateTime                 @default(now())
  createdByUserId String
  createdByUser   User                     @relation("AssignmentCreators", fields: [organisationId, createdByUserId], references: [organisationId, id], onDelete: Restrict)

  @@index([organisationId, clientId, endedAt])
  @@index([organisationId, staffUserId, endedAt])
  @@map("assignment")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

model AuditOperation {
  id                            String                         @id @db.Uuid
  organisationId                String?
  actorKind                     AuditActorKind
  actorUserId                   String?
  action                        String
  targetType                    String
  targetId                      String?
  createdAt                     DateTime                       @default(now())
  events                        AuditEvent[]
  followUpResponsibilityHistory FollowUpResponsibilityHistory?

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("auditOperation")
}

model AuditEvent {
  id               String         @id @default(uuid()) @db.Uuid
  operationId      String         @db.Uuid
  operation        AuditOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  type             AuditEventType
  result           AuditResult
  resolvedTargetId String?
  occurredAt       DateTime       @default(now())

  @@unique([operationId, type])
  @@index([operationId, occurredAt])
  @@map("auditEvent")
}

model JournalEntry {
  id                             String                 @id @db.Uuid
  reference                      String                 @unique @db.VarChar(40)
  organisationId                 String
  organisation                   Organisation           @relation("OrganisationJournalEntries", fields: [organisationId], references: [id], onDelete: Restrict)
  clientId                       String                 @db.Uuid
  client                         Client                 @relation("ClientJournalEntries", fields: [organisationId, clientId], references: [organisationId, id], onDelete: Restrict)
  authorUserId                   String
  author                         User                   @relation("JournalEntryAuthors", fields: [organisationId, authorUserId], references: [organisationId, id], onDelete: Restrict)
  status                         JournalEntryStatus     @default(DRAFT)
  entryType                      JournalEntryType
  eventOccurredAt                DateTime               @db.Timestamptz(3)
  content                        String
  contentFormat                  JournalContentFormat   @default(LEGACY_NARRATIVE)
  healthContent                  String?
  educationOccupationContent     String?
  emotionsBehaviorContent        String?
  socialRelationsContent         String?
  dailyLivingIndependenceContent String?
  otherContent                   String?
  version                        Int                    @default(1)
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  signedAt                       DateTime?              @db.Timestamptz(3)
  signerUserId                   String?
  signerName                     String?
  signerProfessionalTitle        String?
  signerRole                     UserRole?
  correctionOfId                 String?                @db.Uuid
  correctionOf                   JournalEntry?          @relation("JournalCorrections", fields: [organisationId, clientId, correctionOfId], references: [organisationId, clientId, id], onDelete: Restrict)
  corrections                    JournalEntry[]         @relation("JournalCorrections")
  goalReferences                 JournalGoalReference[]

  @@unique([organisationId, clientId, id])
  @@index([organisationId, clientId, status, eventOccurredAt, signedAt, id])
  @@index([organisationId, authorUserId, status])
  @@index([correctionOfId])
  @@map("journalEntry")
}

model Goal {
  id                String                 @id @db.Uuid
  organisationId    String
  organisation      Organisation           @relation("OrganisationGoals", fields: [organisationId], references: [id], onDelete: Restrict, map: "goal_organisationId_fkey")
  clientId          String                 @db.Uuid
  client            Client                 @relation("ClientGoals", fields: [organisationId, clientId], references: [organisationId, id], onDelete: Restrict, map: "goal_scope_client_fkey")
  title             String                 @db.VarChar(200)
  description       String?
  status            GoalStatus             @default(ACTIVE)
  startDate         DateTime               @db.Date
  targetDate        DateTime?              @db.Date
  createdByUserId   String
  createdByUser     User                   @relation("GoalCreators", fields: [organisationId, createdByUserId], references: [organisationId, id], onDelete: Restrict, map: "goal_scope_creator_fkey")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  version           Int                    @default(1)
  completedAt       DateTime?              @db.Timestamptz(3)
  completedByUserId String?
  completedByUser   User?                  @relation("GoalCompletionActors", fields: [organisationId, completedByUserId], references: [organisationId, id], onDelete: Restrict, map: "goal_scope_completed_actor_fkey")
  archivedAt        DateTime?              @db.Timestamptz(3)
  archivedByUserId  String?
  archivedByUser    User?                  @relation("GoalArchiveActors", fields: [organisationId, archivedByUserId], references: [organisationId, id], onDelete: Restrict, map: "goal_scope_archived_actor_fkey")
  followUps         FollowUp[]
  journalReferences JournalGoalReference[]

  @@unique([organisationId, clientId, id], map: "goal_organisationId_clientId_id_key")
  @@index([organisationId, clientId, status, startDate, id], map: "goal_organisationId_clientId_status_startDate_id_idx")
  @@map("goal")
}

model FollowUp {
  id                    String                          @id @db.Uuid
  organisationId        String
  organisation          Organisation                    @relation("OrganisationFollowUps", fields: [organisationId], references: [id], onDelete: Restrict, map: "followUp_organisationId_fkey")
  clientId              String                          @db.Uuid
  client                Client                          @relation("ClientFollowUps", fields: [organisationId, clientId], references: [organisationId, id], onDelete: Restrict, map: "followUp_scope_client_fkey")
  title                 String                          @db.VarChar(200)
  description           String?
  dueDate               DateTime                        @db.Date
  dueTime               String?                         @db.VarChar(5)
  dueAt                 DateTime?                       @db.Timestamptz(3)
  status                FollowUpStatus                  @default(PLANNED)
  goalId                String?                         @db.Uuid
  goal                  Goal?                           @relation(fields: [organisationId, clientId, goalId], references: [organisationId, clientId, id], onDelete: Restrict, map: "followUp_scope_goal_fkey")
  createdByUserId       String
  createdByUser         User                            @relation("FollowUpCreators", fields: [organisationId, createdByUserId], references: [organisationId, id], onDelete: Restrict, map: "followUp_scope_creator_fkey")
  responsibleUserId     String
  responsibleUser       User                            @relation("FollowUpResponsibleUsers", fields: [organisationId, responsibleUserId], references: [organisationId, id], onDelete: Restrict, map: "followUp_scope_responsible_fkey")
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  version               Int                             @default(1)
  completedAt           DateTime?                       @db.Timestamptz(3)
  completedByUserId     String?
  completedByUser       User?                           @relation("FollowUpCompletionActors", fields: [organisationId, completedByUserId], references: [organisationId, id], onDelete: Restrict, map: "followUp_scope_completed_actor_fkey")
  cancelledAt           DateTime?                       @db.Timestamptz(3)
  cancelledByUserId     String?
  cancelledByUser       User?                           @relation("FollowUpCancellationActors", fields: [organisationId, cancelledByUserId], references: [organisationId, id], onDelete: Restrict, map: "followUp_scope_cancelled_actor_fkey")
  responsibilityHistory FollowUpResponsibilityHistory[]

  @@unique([organisationId, clientId, id], map: "followUp_organisationId_clientId_id_key")
  @@index([organisationId, clientId, status, dueDate, dueTime, id], map: "followUp_organisationId_clientId_status_dueDate_dueTime_id_idx")
  @@index([organisationId, responsibleUserId, status, dueDate, dueTime, id], map: "followUp_organisationId_responsible_status_due_idx")
  @@index([goalId], map: "followUp_goalId_idx")
  @@map("followUp")
}

model FollowUpResponsibilityHistory {
  id                        String         @id @db.Uuid
  organisationId            String
  clientId                  String         @db.Uuid
  followUpId                String         @db.Uuid
  followUp                  FollowUp       @relation(fields: [organisationId, clientId, followUpId], references: [organisationId, clientId, id], onDelete: Restrict, map: "history_scope_followUp_fkey")
  previousResponsibleUserId String
  previousResponsibleUser   User           @relation("PreviousResponsibleUsers", fields: [organisationId, previousResponsibleUserId], references: [organisationId, id], onDelete: Restrict, map: "history_scope_previous_user_fkey")
  newResponsibleUserId      String
  newResponsibleUser        User           @relation("NewResponsibleUsers", fields: [organisationId, newResponsibleUserId], references: [organisationId, id], onDelete: Restrict, map: "history_scope_new_user_fkey")
  actorUserId               String
  actorUser                 User           @relation("ResponsibilityChangeActors", fields: [organisationId, actorUserId], references: [organisationId, id], onDelete: Restrict, map: "history_scope_actor_fkey")
  followUpVersion           Int
  changedAt                 DateTime       @default(now()) @db.Timestamptz(3)
  auditOperationId          String         @unique(map: "history_audit_operation_key") @db.Uuid
  auditOperation            AuditOperation @relation(fields: [auditOperationId], references: [id], onDelete: Restrict, map: "history_audit_operation_fkey")

  @@unique([followUpId, followUpVersion], map: "followUpResponsibilityHistory_followUp_version_key")
  @@index([organisationId, clientId, followUpId, changedAt, id], map: "followUpResponsibilityHistory_scope_changed_idx")
  @@map("followUpResponsibilityHistory")
}

model JournalGoalReference {
  organisationId String
  clientId       String       @db.Uuid
  journalEntryId String       @db.Uuid
  journalEntry   JournalEntry @relation(fields: [organisationId, clientId, journalEntryId], references: [organisationId, clientId, id], onDelete: Restrict, map: "journalGoalReference_scope_entry_fkey")
  goalId         String       @db.Uuid
  goal           Goal         @relation(fields: [organisationId, clientId, goalId], references: [organisationId, clientId, id], onDelete: Restrict, map: "journalGoalReference_scope_goal_fkey")
  titleSnapshot  String?      @db.VarChar(200)
  createdAt      DateTime     @default(now())

  @@id([journalEntryId, goalId])
  @@index([organisationId, clientId, goalId], map: "journalGoalReference_scope_goal_idx")
  @@map("journalGoalReference")
}

model MonthlyReport {
  id                             String              @id @db.Uuid
  reference                      String              @unique @db.VarChar(40)
  organisationId                 String
  organisation                   Organisation        @relation("OrganisationMonthlyReports", fields: [organisationId], references: [id], onDelete: Restrict, map: "monthlyReport_organisationId_fkey")
  clientId                       String              @db.Uuid
  client                         Client              @relation("ClientMonthlyReports", fields: [organisationId, clientId], references: [organisationId, id], onDelete: Restrict, map: "monthlyReport_scope_client_fkey")
  calendarYear                   Int
  calendarMonth                  Int
  revision                       Int                 @default(1)
  replacesReportId               String?             @db.Uuid
  replacesReport                 MonthlyReport?      @relation("MonthlyReportReplacements", fields: [organisationId, clientId, calendarYear, calendarMonth, replacesReportId], references: [organisationId, clientId, calendarYear, calendarMonth, id], onDelete: Restrict, map: "monthlyReport_scope_replacement_fkey")
  replacement                    MonthlyReport?      @relation("MonthlyReportReplacements")
  status                         MonthlyReportStatus @default(DRAFT)
  healthContent                  String?
  educationOccupationContent     String?
  emotionsBehaviorContent        String?
  socialRelationsContent         String?
  dailyLivingIndependenceContent String?
  otherContent                   String?
  version                        Int                 @default(1)
  createdByUserId                String
  createdByUser                  User                @relation("MonthlyReportCreators", fields: [organisationId, createdByUserId], references: [organisationId, id], onDelete: Restrict, map: "monthlyReport_scope_creator_fkey")
  updatedByUserId                String
  updatedByUser                  User                @relation("MonthlyReportUpdaters", fields: [organisationId, updatedByUserId], references: [organisationId, id], onDelete: Restrict, map: "monthlyReport_scope_updater_fkey")
  createdAt                      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime            @updatedAt @db.Timestamptz(3)
  signedAt                       DateTime?           @db.Timestamptz(3)
  signerUserId                   String?
  signerName                     String?
  signerProfessionalTitle        String?
  signerRole                     UserRole?

  @@unique([organisationId, clientId, calendarYear, calendarMonth, id], map: "monthlyReport_scope_id_key")
  @@unique([organisationId, clientId, calendarYear, calendarMonth, revision], map: "monthlyReport_scope_revision_key")
  @@unique([organisationId, clientId, calendarYear, calendarMonth, replacesReportId], map: "monthlyReport_replacement_link_key")
  @@index([organisationId, clientId, calendarYear, calendarMonth, status, revision], map: "monthlyReport_scope_status_revision_idx")
  @@map("monthlyReport")
}

model Document {
  id               String            @id @db.Uuid
  organisationId   String
  organisation     Organisation      @relation("OrganisationDocuments", fields: [organisationId], references: [id], onDelete: Restrict, map: "document_organisationId_fkey")
  clientId         String            @db.Uuid
  client           Client            @relation("ClientDocuments", fields: [organisationId, clientId], references: [organisationId, id], onDelete: Restrict, map: "document_scope_client_fkey")
  title            String            @db.VarChar(200)
  description      String?
  status           DocumentStatus    @default(ACTIVE)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  createdByUserId  String
  createdByUser    User              @relation("DocumentCreators", fields: [organisationId, createdByUserId], references: [organisationId, id], onDelete: Restrict, map: "document_scope_creator_fkey")
  archivedAt       DateTime?         @db.Timestamptz(3)
  archivedByUserId String?
  archivedByUser   User?             @relation("DocumentArchiveActors", fields: [organisationId, archivedByUserId], references: [organisationId, id], onDelete: Restrict, map: "document_scope_archive_actor_fkey")
  versions         DocumentVersion[]

  @@unique([organisationId, clientId, id], map: "document_organisationId_clientId_id_key")
  @@index([organisationId, clientId, status, createdAt, id], map: "document_scope_status_created_idx")
  @@map("document")
}

model DocumentVersion {
  id                      String             @id @db.Uuid
  organisationId          String
  organisation            Organisation       @relation("OrganisationDocumentVersions", fields: [organisationId], references: [id], onDelete: Restrict, map: "documentVersion_organisationId_fkey")
  clientId                String             @db.Uuid
  client                  Client             @relation("ClientDocumentVersions", fields: [organisationId, clientId], references: [organisationId, id], onDelete: Restrict, map: "documentVersion_scope_client_fkey")
  documentId              String             @db.Uuid
  document                Document           @relation(fields: [organisationId, clientId, documentId], references: [organisationId, clientId, id], onDelete: Restrict, map: "documentVersion_scope_document_fkey")
  versionNumber           Int
  originalFilename        String             @db.VarChar(255)
  displayFilename         String             @db.VarChar(180)
  mediaType               String             @db.VarChar(64)
  approvedExtension       String             @db.VarChar(8)
  sizeBytes               BigInt
  storageKey              String             @unique(map: "documentVersion_storageKey_key") @db.VarChar(64)
  sha256                  String             @db.Char(64)
  uploadedAt              DateTime           @default(now()) @db.Timestamptz(3)
  uploadedByUserId        String
  uploadedByUser          User               @relation("DocumentVersionUploaders", fields: [organisationId, uploadedByUserId], references: [organisationId, id], onDelete: Restrict, map: "documentVersion_scope_uploader_fkey")
  malwareScanResult       DocumentScanResult @default(CLEAN)
  malwareScanner          String             @db.VarChar(64)
  malwareScannerVersion   String             @db.VarChar(64)
  malwareSignatureVersion String             @db.VarChar(64)
  malwareSignatureDate    DateTime           @db.Timestamptz(3)
  malwareScannedAt        DateTime           @db.Timestamptz(3)

  @@unique([documentId, versionNumber], map: "documentVersion_documentId_versionNumber_key")
  @@unique([organisationId, clientId, id], map: "documentVersion_organisationId_clientId_id_key")
  @@index([organisationId, clientId, documentId, versionNumber], map: "documentVersion_scope_document_version_idx")
  @@map("documentVersion")
}
