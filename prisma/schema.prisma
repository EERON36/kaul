generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMINISTRATOR
  STAFF_MEMBER
}

enum ClientStatus {
  INACTIVE
  ACTIVE
  ARCHIVED
}

enum AssignmentResponsibility {
  PRIMARY
  SECONDARY
}

enum AuditActorKind {
  USER
  SYSTEM
  UNAUTHENTICATED
}

enum AuditEventType {
  OUTCOME
  RECOVERY
}

enum AuditResult {
  SUCCEEDED
  FAILED
  AMBIGUOUS
}

model Organisation {
  id          String       @id
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  clients     Client[]     @relation("OrganisationClients")
  assignments Assignment[] @relation("OrganisationAssignments")

  @@map("organisation")
}

model User {
  id                           String       @id
  name                         String
  email                        String
  emailVerified                Boolean      @default(false)
  image                        String?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
  role                         UserRole     @default(STAFF_MEMBER)
  banned                       Boolean?     @default(false)
  banReason                    String?
  banExpires                   DateTime?
  organisationId               String
  organisation                 Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  professionalTitle            String
  mustChangePassword           Boolean      @default(true)
  temporaryCredentialExpiresAt DateTime?
  sessions                     Session[]
  accounts                     Account[]
  staffAssignments             Assignment[] @relation("StaffAssignments")
  createdAssignments           Assignment[] @relation("AssignmentCreators")

  @@unique([email])
  @@unique([organisationId, id])
  @@index([organisationId])
  @@map("user")
}

model Client {
  id               String       @id @db.Uuid
  organisationId   String
  organisation     Organisation @relation("OrganisationClients", fields: [organisationId], references: [id], onDelete: Restrict)
  firstName        String
  lastName         String
  personIdentifier String
  category         String
  status           ClientStatus @default(INACTIVE)
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  assignments      Assignment[] @relation("ClientAssignments")

  @@unique([organisationId, personIdentifier])
  @@unique([organisationId, id])
  @@index([organisationId, status, lastName, firstName, personIdentifier])
  @@map("client")
}

model Assignment {
  id              String                   @id @db.Uuid
  organisationId  String
  organisation    Organisation             @relation("OrganisationAssignments", fields: [organisationId], references: [id], onDelete: Restrict)
  clientId        String                   @db.Uuid
  client          Client                   @relation("ClientAssignments", fields: [organisationId, clientId], references: [organisationId, id], onDelete: Restrict)
  staffUserId     String
  staffUser       User                     @relation("StaffAssignments", fields: [organisationId, staffUserId], references: [organisationId, id], onDelete: Restrict)
  responsibility  AssignmentResponsibility
  startedAt       DateTime                 @default(now())
  endedAt         DateTime?
  createdAt       DateTime                 @default(now())
  createdByUserId String
  createdByUser   User                     @relation("AssignmentCreators", fields: [organisationId, createdByUserId], references: [organisationId, id], onDelete: Restrict)

  @@index([organisationId, clientId, endedAt])
  @@index([organisationId, staffUserId, endedAt])
  @@map("assignment")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

model AuditOperation {
  id             String         @id @db.Uuid
  organisationId String?
  actorKind      AuditActorKind
  actorUserId    String?
  action         String
  targetType     String
  targetId       String?
  createdAt      DateTime       @default(now())
  events         AuditEvent[]

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("auditOperation")
}

model AuditEvent {
  id               String         @id @default(uuid()) @db.Uuid
  operationId      String         @db.Uuid
  operation        AuditOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  type             AuditEventType
  result           AuditResult
  resolvedTargetId String?
  occurredAt       DateTime       @default(now())

  @@unique([operationId, type])
  @@index([operationId, occurredAt])
  @@map("auditEvent")
}
