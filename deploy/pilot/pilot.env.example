# Copy this file outside the repository, restrict it to the operator, and
# replace every placeholder. Use URL-safe random values for all secrets.
COMPOSE_PROJECT_NAME=kaul-pilot

# Operators select an immutable release digest. Never use latest.
KAUL_IMAGE=ghcr.io/example/kaul@sha256:REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS

# Direct/DNS-only Caddy is the approved initial shape.
PILOT_HOSTNAME=pilot.example.com
PILOT_HTTP_BIND=80
PILOT_HTTPS_BIND=443
PILOT_HTTPS_UDP_BIND=443

DEPLOYMENT_ENV=pilot
BETTER_AUTH_URL=https://pilot.example.com
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_URL_SAFE_CHARACTERS

# The PostgreSQL administrator is used only for database administration.
POSTGRES_ADMIN_USER=kaul_pilot_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_URL_SAFE_CHARACTERS

# Kaul runs with this separate, non-superuser database owner.
KAUL_DB_USER=kaul_pilot_app
KAUL_DB_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_URL_SAFE_CHARACTERS
KAUL_DB_NAME=kaul_pilot
DATABASE_URL=postgresql://kaul_pilot_app:REPLACE_WITH_AT_LEAST_32_RANDOM_URL_SAFE_CHARACTERS@postgres:5432/kaul_pilot
