{$PILOT_HOSTNAME} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	reverse_proxy kaul:3000 {
		# Kaul trusts only X-Real-IP for authentication rate limiting. This
		# assignment overwrites any client-supplied value with Caddy's direct
		# peer address. Do not put a CDN in front without a separate trusted-
		# proxy review.
		header_up X-Real-IP {remote_host}
		header_up -Forwarded
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
	}
}
